DEBUG=False
SECRET_KEY=<strong-secret>
ALLOWED_HOSTS=<your-domain-or-server-ip>
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=https://<your-api-domain>
ENABLE_ADMIN=False
ENABLE_API_DOCS=False
PUBLIC_API_BASE_URL=https://<your-api-domain>
PRIVACY_NOTICE_VERSION=2026-08-05

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=CHANGE_ME_RESEND_API_KEY
DEFAULT_FROM_EMAIL=<default-from-email>
EMAIL_CHALLENGE_TTL_SECONDS=900
EMAIL_CHALLENGE_MAX_ATTEMPTS=5
DEMO_MAX_VERIFIED_USERS=100
REGISTRATION_ENABLED=True

POSTGRES_DB=medstory
POSTGRES_USER=medstory
POSTGRES_PASSWORD=<strong-db-password>
DATABASE_URL=postgres://medstory:<strong-db-password>@db:5432/medstory

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
THROTTLE_CACHE_URL=redis://redis:6379/1
THROTTLE_TRUSTED_PROXY_COUNT=1

AI_LLM_PROVIDER=openai
AI_OCR_PROVIDER=openai
AI_STT_PROVIDER=openai
AI_OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
AI_OPENAI_MODEL=gpt-5.4-nano
AI_OPENAI_SUMMARY_MODEL=gpt-5.4-mini
AI_OPENAI_OCR_MODEL=gpt-5.4-nano
AI_OPENAI_STT_MODEL=gpt-4o-mini-transcribe
AI_OPENAI_TIMEOUT_SECONDS=60
AI_ENABLED=True
AI_USER_DAILY_UNITS=10
AI_GLOBAL_DAILY_UNITS=20
AI_GLOBAL_MONTHLY_UNITS=150

ORIGINAL_STORAGE_BACKEND=s3
ORIGINAL_STORAGE_REQUIRE_S3=True
ORIGINAL_STORAGE_ENDPOINT=https://garage-proxy
ORIGINAL_STORAGE_REGION=medstory
ORIGINAL_STORAGE_BUCKET=medstory-originals
ORIGINAL_STORAGE_VERIFY_TLS=True
ORIGINAL_MASTER_KEY_VERSION=1
ORIGINAL_STRICT_FILE_VALIDATION=True
ORIGINAL_MALWARE_SCANNER=clamav
ORIGINAL_STORAGE_QUOTA_BYTES=104857600
CLAMAV_HOST=clamav
